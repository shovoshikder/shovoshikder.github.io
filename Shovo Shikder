<script>
(function () {
  var c = document.getElementById('rain'), x = c.getContext('2d');
  var size = 16, drops = [], w = 0, h = 0, last = 0, tick = 0, bg = '#000', fg = '#0f0';
  var chars = '01{}<>/;ABCDEF'.split('');
  function pick() { return chars[Math.floor(Math.random() * chars.length)]; }
  function colors() {
    var s = getComputedStyle(document.documentElement);
    bg = s.getPropertyValue('--bg').trim() || bg;
    fg = s.getPropertyValue('--accent').trim() || fg;
  }
  function resize() {
    var d = Math.min(window.devicePixelRatio || 1, 2);
    w = window.innerWidth; h = window.innerHeight;
    c.width = w * d; c.height = h * d;
    x.setTransform(d, 0, 0, d, 0, 0);
    colors();
    x.globalAlpha = 1; x.fillStyle = bg; x.fillRect(0, 0, w, h);
    x.font = size + 'px monospace';
    drops = [];
    for (var i = 0; i < Math.ceil(w / size); i++) drops.push(Math.random() * h / size);
    if (reduce) still();
  }
  function still() {
    x.globalAlpha = 0.5; x.fillStyle = fg;
    for (var n = 0; n < 500; n++) x.fillText(pick(), Math.random() * w, Math.random() * h);
  }
  function frame(t) {
    requestAnimationFrame(frame);
    if (t - last < 60) return;
    last = t;
    if (++tick % 40 === 0) colors();
    x.globalAlpha = 0.1; x.fillStyle = bg; x.fillRect(0, 0, w, h);
    x.globalAlpha = 1; x.fillStyle = fg;
    for (var i = 0; i < drops.length; i++) {
      x.fillText(pick(), i * size, drops[i] * size);
      if (drops[i] * size > h && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    }
  }
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  resize();
  window.addEventListener('resize', resize);
  if (!reduce) requestAnimationFrame(frame);
})();
</script>
